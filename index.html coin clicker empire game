<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coin Clicker Empire</title>
    <style>
        /* ========== ROOT & VARIABLES ========== */
        :root {
            --primary: #FFD700;
            --primary-dark: #FFC700;
            --secondary: #FF6B6B;
            --success: #51CF66;
            --bg: #1a1a2e;
            --bg-light: #16213e;
            --bg-lighter: #0f3460;
            --text: #eaeaea;
            --text-muted: #b0b0b0;
            --card-bg: #16213e;
            --border: #0f3460;
        }

        body.light-mode {
            --primary: #FFD700;
            --primary-dark: #FFC700;
            --secondary: #FF6B6B;
            --success: #51CF66;
            --bg: #f5f5f5;
            --bg-light: #ffffff;
            --bg-lighter: #efefef;
            --text: #333333;
            --text-muted: #777777;
            --card-bg: #ffffff;
            --border: #dddddd;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--bg);
            color: var(--text);
            transition: background 0.3s, color 0.3s;
            overflow-x: hidden;
        }

        /* ========== ANIMATED BACKGROUND ========== */
        .animated-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: linear-gradient(135deg, var(--bg) 0%, var(--bg-light) 100%);
            opacity: 0.5;
        }

        .particle-bg {
            position: absolute;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .floating-particle {
            position: absolute;
            pointer-events: none;
        }

        /* ========== HEADER ========== */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background: rgba(0, 0, 0, 0.3);
            border-bottom: 2px solid var(--border);
            flex-wrap: wrap;
            gap: 20px;
        }

        .logo {
            font-size: 28px;
            font-weight: bold;
            color: var(--primary);
            text-shadow: 0 0 10px var(--primary);
        }

        .coin-count {
            font-size: 32px;
            font-weight: bold;
            color: var(--primary);
            text-shadow: 0 0 15px var(--primary);
            text-align: center;
            flex: 1;
            min-width: 200px;
        }

        .coin-count-label {
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .controls {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        button {
            padding: 10px 15px;
            border: 2px solid var(--primary);
            background: rgba(255, 215, 0, 0.1);
            color: var(--primary);
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        button:hover {
            background: var(--primary);
            color: var(--bg);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 215, 0, 0.4);
        }

        button:active {
            transform: translateY(0);
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        /* ========== MAIN CONTAINER ========== */
        .container {
            display: grid;
            grid-template-columns: 1fr 250px;
            gap: 20px;
            padding: 20px;
            max-width: 1400px;
            margin: 0 auto;
            height: calc(100vh - 120px);
        }

        @media (max-width: 1024px) {
            .container {
                grid-template-columns: 1fr;
                height: auto;
            }
        }

        /* ========== MAIN GAME AREA ========== */
        .game-area {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .clicker-section {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 30px;
            min-height: 400px;
        }

        .coin-button {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            border: 4px solid var(--primary);
            background: radial-gradient(circle at 30% 30%, rgba(255, 215, 0, 0.3), rgba(255, 215, 0, 0.05));
            cursor: pointer;
            font-size: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.1s;
            box-shadow: 0 0 30px var(--primary);
            position: relative;
            overflow: hidden;
            user-select: none;
        }

        .coin-button:hover {
            transform: scale(1.1);
            box-shadow: 0 0 50px var(--primary);
        }

        .coin-button:active {
            transform: scale(0.95);
        }

        .coin-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            pointer-events: none;
        }

        .cps-display {
            font-size: 18px;
            color: var(--success);
            text-align: center;
        }

        .cps-value {
            font-weight: bold;
            color: var(--primary);
        }

        /* ========== SHOP SECTION ========== */
        .shop-section {
            background: var(--card-bg);
            border: 2px solid var(--border);
            border-radius: 10px;
            padding: 20px;
        }

        .shop-title {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 15px;
            color: var(--primary);
            text-align: center;
        }

        .upgrades-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .upgrade-card {
            background: var(--bg-light);
            border: 2px solid var(--border);
            border-radius: 8px;
            padding: 12px;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

        .upgrade-card:hover:not(:disabled) {
            border-color: var(--primary);
            background: rgba(255, 215, 0, 0.1);
            transform: translateX(5px);
        }

        .upgrade-card:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .upgrade-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
            font-weight: bold;
            font-size: 13px;
        }

        .upgrade-name {
            color: var(--primary);
        }

        .upgrade-count {
            color: var(--success);
        }

        .upgrade-info {
            font-size: 11px;
            color: var(--text-muted);
        }

        .upgrade-cost {
            font-size: 13px;
            font-weight: bold;
            color: var(--primary);
            margin-top: 5px;
        }

        /* ========== SIDEBAR ========== */
        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 20px;
            min-width: 250px;
        }

        .panel {
            background: var(--card-bg);
            border: 2px solid var(--border);
            border-radius: 10px;
            padding: 15px;
        }

        .panel-title {
            font-size: 14px;
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 13px;
            padding: 5px 0;
            border-bottom: 1px solid var(--border);
        }

        .stat-label {
            color: var(--text-muted);
        }

        .stat-value {
            font-weight: bold;
            color: var(--primary);
        }

        .progress-bar {
            width: 100%;
            height: 8px;
            background: var(--bg-light);
            border-radius: 4px;
            margin-top: 8px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--secondary), var(--primary));
            border-radius: 4px;
            transition: width 0.3s;
        }

        /* ========== ACHIEVEMENTS ========== */
        .achievements-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
            gap: 10px;
            margin-top: 10px;
        }

        .achievement {
            aspect-ratio: 1;
            background: var(--bg-light);
            border: 2px solid var(--border);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            cursor: default;
            transition: all 0.3s;
            position: relative;
        }

        .achievement.unlocked {
            border-color: var(--primary);
            background: rgba(255, 215, 0, 0.1);
            box-shadow: 0 0 10px var(--primary);
        }

        .achievement[data-tooltip]:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: -30px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--bg-light);
            border: 1px solid var(--border);
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 10px;
            white-space: nowrap;
            z-index: 10;
            pointer-events: none;
        }

        /* ========== NOTIFICATION ========== */
        .notification {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: var(--card-bg);
            border: 2px solid var(--primary);
            border-radius: 10px;
            padding: 15px 20px;
            color: var(--text);
            z-index: 1000;
            animation: slideIn 0.4s ease-out;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
        }

        @keyframes slideIn {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .notification-title {
            color: var(--primary);
            font-weight: bold;
            margin-bottom: 5px;
        }

        .notification-text {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* ========== FLOATING TEXT ========== */
        .floating-text {
            position: fixed;
            font-weight: bold;
            font-size: 24px;
            color: var(--primary);
            pointer-events: none;
            text-shadow: 0 0 10px var(--primary);
            animation: floatUp 1s ease-out forwards;
        }

        @keyframes floatUp {
            0% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            100% {
                opacity: 0;
                transform: translateY(-80px) scale(1.5);
            }
        }

        /* ========== MODAL ========== */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 2000;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.3s;
        }

        .modal.active {
            display: flex;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .modal-content {
            background: var(--card-bg);
            border: 3px solid var(--primary);
            border-radius: 15px;
            padding: 30px;
            max-width: 500px;
            width: 90%;
            text-align: center;
            animation: slideDown 0.3s;
        }

        @keyframes slideDown {
            from {
                transform: translateY(-50px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .modal-title {
            font-size: 28px;
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 15px;
        }

        .modal-text {
            color: var(--text);
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .modal-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* ========== PRESTIGE ========== */
        .prestige-info {
            background: rgba(255, 215, 0, 0.1);
            border: 2px solid var(--primary);
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 10px;
            font-size: 12px;
        }

        .prestige-level {
            color: var(--primary);
            font-weight: bold;
        }

        .prestige-bonus {
            color: var(--success);
            font-size: 11px;
        }

        /* ========== DAILY REWARD ========== */
        .daily-reward {
            background: rgba(81, 207, 102, 0.1);
            border: 2px solid var(--success);
            border-radius: 8px;
            padding: 10px;
            text-align: center;
            font-size: 12px;
        }

        .daily-reward-amount {
            color: var(--success);
            font-weight: bold;
        }

        .daily-reward-timer {
            color: var(--text-muted);
            font-size: 11px;
        }

        /* ========== FOOTER ========== */
        .footer {
            background: rgba(0, 0, 0, 0.3);
            border-top: 2px solid var(--border);
            padding: 15px;
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
        }

        /* ========== RESPONSIVE ========== */
        @media (max-width: 768px) {
            .coin-button {
                width: 150px;
                height: 150px;
                font-size: 60px;
            }

            .coin-count {
                font-size: 24px;
            }

            .sidebar {
                min-width: auto;
            }

            .header {
                flex-direction: column;
                gap: 10px;
            }

            .controls {
                width: 100%;
                justify-content: center;
            }

            .coin-count {
                flex: none;
                min-width: auto;
            }
        }

        /* ========== THEMES ========== */
        body.theme-neon {
            --primary: #00FF00;
            --primary-dark: #00DD00;
            --secondary: #FF00FF;
            --success: #00FFFF;
        }

        body.theme-sunset {
            --primary: #FF6B35;
            --primary-dark: #FF5722;
            --secondary: #FF8C42;
            --success: #FFA630;
        }

        body.theme-ocean {
            --primary: #00D9FF;
            --primary-dark: #00B5D8;
            --secondary: #0099FF;
            --success: #00FF88;
        }
    </style>
</head>
<body>
    <!-- ANIMATED BACKGROUND -->
    <div class="animated-bg">
        <div class="particle-bg" id="particleContainer"></div>
    </div>

    <!-- HEADER -->
    <header class="header">
        <div class="logo">💰 Coin Clicker Empire</div>
        <div class="coin-count">
            <div class="coin-count-label">Total Coins</div>
            <div id="coinCount">0</div>
        </div>
        <div class="controls">
            <button id="howToPlayBtn" title="How to Play">❓</button>
            <button id="darkModeBtn" title="Toggle Dark Mode">🌙</button>
            <button id="themeBtn" title="Change Theme">🎨</button>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <div class="container">
        <!-- GAME AREA -->
        <div class="game-area">
            <!-- CLICKER SECTION -->
            <div class="clicker-section">
                <button class="coin-button" id="coinButton">💰</button>
                <div class="cps-display">
                    <span>Earning </span><span class="cps-value" id="cpsValue">0</span><span> coins per second</span>
                </div>
            </div>

            <!-- SHOP SECTION -->
            <div class="shop-section">
                <div class="shop-title">🏪 Shop</div>
                <div class="upgrades-grid" id="upgradesGrid"></div>
            </div>
        </div>

        <!-- SIDEBAR -->
        <div class="sidebar">
            <!-- PRESTIGE PANEL -->
            <div class="panel" id="prestigePanel" style="display: none;">
                <div class="panel-title">✨ Prestige</div>
                <div class="prestige-info">
                    <div class="prestige-level">Level: <span id="prestigeLevel">0</span></div>
                    <div class="prestige-bonus">Bonus: <span id="prestigeBonus">0</span>%</div>
                </div>
                <button id="prestigeBtn" style="width: 100%; margin-top: 10px;">Reset for Prestige</button>
            </div>

            <!-- DAILY REWARD PANEL -->
            <div class="panel" id="dailyRewardPanel" style="display: none;">
                <div class="panel-title">🎁 Daily Reward</div>
                <div class="daily-reward" id="dailyRewardStatus">
                    <div class="daily-reward-amount">Claim 50 bonus coins!</div>
                    <button id="claimRewardBtn" style="width: 100%; margin-top: 8px;">Claim</button>
                </div>
            </div>

            <!-- ACHIEVEMENTS PANEL -->
            <div class="panel">
                <div class="panel-title">🏆 Achievements</div>
                <div class="achievements-container" id="achievementsContainer"></div>
            </div>

            <!-- STATISTICS PANEL -->
            <div class="panel">
                <div class="panel-title">📊 Stats</div>
                <div class="stat-item">
                    <span class="stat-label">Total Earned:</span>
                    <span class="stat-value" id="totalEarned">0</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Total Clicks:</span>
                    <span class="stat-value" id="totalClicks">0</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Time Played:</span>
                    <span class="stat-value" id="timePlayed">0m</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" id="achievementProgress"></div>
                </div>
            </div>

            <!-- ACTION BUTTONS -->
            <div class="panel" style="padding: 10px;">
                <button id="resetBtn" style="width: 100%; margin-bottom: 10px;">Reset Save</button>
                <button id="exportBtn" style="width: 100%;">Export Save</button>
            </div>
        </div>
    </div>

    <!-- MODALS -->
    <div class="modal" id="confirmModal">
        <div class="modal-content">
            <div class="modal-title" id="confirmTitle">Confirm</div>
            <div class="modal-text" id="confirmText"></div>
            <div class="modal-buttons">
                <button id="confirmYes">Yes</button>
                <button id="confirmNo">No</button>
            </div>
        </div>
    </div>

    <div class="modal" id="themeModal">
        <div class="modal-content">
            <div class="modal-title">Choose Theme</div>
            <div class="modal-buttons" style="flex-direction: column;">
                <button id="themeDefault">🌟 Default</button>
                <button id="themeNeon">💚 Neon</button>
                <button id="themeSunset">🌅 Sunset</button>
                <button id="themeOcean">🌊 Ocean</button>
            </div>
        </div>
    </div>

    <div class="modal" id="howToPlayModal">
        <div class="modal-content" style="max-width: 600px; max-height: 80vh; overflow-y: auto;">
            <div class="modal-title">📖 How to Play</div>
            
            <div style="text-align: left; margin-bottom: 20px; font-size: 14px; line-height: 1.8;">
